# Copy this file to .env beside docker-compose.yml and set values per PC.
# Linux example: /home/your-user/Desktop/docker/volume
# Windows example: C:/Users/your-user/Desktop/docker/volume
VOLUME_ROOT=/home/your-user/Desktop/docker/volume
DB_ROOT_PASSWORD=replace-with-a-strong-root-password
# Use the host's LAN IP instead of localhost for dashboard users on other devices.
NEXT_PUBLIC_FRAPPE_URL=http://localhost:8000
